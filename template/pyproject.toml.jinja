[build-system]
requires = ["uv_build>=0.10.0,<0.11.0"]
build-backend = "uv_build"

[project]
name = "{{ project_name | lower | replace(' ', '-') }}"
version = "0.1.0"
description = "{{ description }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
readme = "README.md"
requires-python = ">={{ python_version.split(',')[0] }}"
dependencies = [
    "typer>=0.12",
]

[project.scripts]
{{ cli_command }} = "{{ package_name }}.cli:app"

[dependency-groups]
dev = [
    "prek",
    "pytest>=8",
    "pytest-cov",
    "pytest-mock",
    "pytest-asyncio",
    "ruff",
    "ty",
]

[tool.uv]
package = true
exclude-newer = "3d"
{% if use_cuda %}

[[tool.uv.index]]
name = "pytorch-cu130"
url = "https://download.pytorch.org/whl/cu130"
explicit = true

[tool.uv.sources]
torch = [{ index = "pytorch-cu130" }]
torchvision = [{ index = "pytorch-cu130" }]
torchaudio = [{ index = "pytorch-cu130" }]
{% endif %}

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "--cov={{ package_name }} --cov-report=term-missing --cov-report=xml"
asyncio_mode = "auto"

[tool.coverage.run]
branch = true
source = ["{{ package_name }}"]

[tool.coverage.report]
show_missing = true

[tool.ruff]
line-length = 88

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]
