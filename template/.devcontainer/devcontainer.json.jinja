{
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "tamasfe.even-better-toml",
        "MermaidChart.vscode-mermaid-chart",
        "esbenp.prettier-vscode",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "nefrob.vscode-just-syntax",
        "astral-sh.ty"{% if use_terraform %},
        "hashicorp.terraform"{% endif %}{% if use_aws %},
        "amazonwebservices.aws-toolkit-vscode"{% endif %}{% if use_azure %},
        "ms-vscode.vscode-node-azure-pack"{% endif %}
      ],
      "settings": {
        "github.copilot.enable": {
          "*": false
        },
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.rulers": [88],
        "prettier.printWidth": 88,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[just]": {
          "editor.formatOnSave": false
        },
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml"
        },
        "[mermaid]": {
          "editor.formatOnSave": false
        },
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.languageServer": "Pylance",
        "ruff.nativeServer": "on",
        "ty.disableLanguageServices": true,
        "chat.disableAIFeatures": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "python.testing.unittestEnabled": false,
        "python.testing.pytestEnabled": true,
        "vscode-just.useSingleTerminal": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "[jupyter]": {
          "editor.formatOnSave": false
        }{% if use_terraform %},
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        }{% endif %}
      }
    }
  },
  "features": {
    {% if use_terraform %}"ghcr.io/devcontainers/features/terraform:1": {},{% endif %}
    {% if use_aws %}"ghcr.io/devcontainer-community/devcontainer-features/aws-cli:1": {},{% endif %}
    {% if use_azure %}"ghcr.io/devcontainers/features/azure-cli:1": {},{% endif %}
    {% if use_docker_in_docker %}"ghcr.io/devcontainers/features/docker-in-docker:2": {"moby": false},{% endif %}
    {% if use_docker_in_docker and use_cuda %}"ghcr.io/srzstephen/devcontainer-features/nvidia-container-toolkit:0": {},{% endif %}

    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {
      "shellautocompletion": true
    },
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/github.com-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/srzstephen/devcontainer-features/act:0": {},
    "ghcr.io/tobiaschc/devcontainer-features/starship:1": {
      "userShell": "zsh"
    },
    "ghcr.io/srzstephen/devcontainer-features/claude-code:0": {
      "marketplace": "https://github.com/obra/superpowers-marketplace",
      "plugin": "superpowers@superpowers-marketplace",
      "removeAttribution": true,
      "statusline": true
    },
    "ghcr.io/srzstephen/devcontainer-features/just:0": {},
    {% if use_cuda %}
    "ghcr.io/devcontainers/features/nvidia-cuda:3": {
      "installCudnn": true,
      "cudaVersion": "13.1"
    },
    {% endif %}
  },
  "portsAttributes": {
  },
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "mounts": [
    "source=${localEnv:HOME}/.cache/uv,target=/home/vscode/.cache/uv,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cache/huggingface,target=/home/vscode/.cache/huggingface,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cache/devcontainer,target=/var/cache/apt,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude/projects,target=/home/vscode/.claude/projects,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.npm,target=/home/vscode/.npm,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.cache/pre-commit,target=/home/vscode/.cache/pre-commit,type=bind,consistency=cached"
  ],
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "name": "Python Dev",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "remoteEnv": {
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
  },
  "containerEnv":
  {
    "TZ": "${localEnv:TZ}"
  }{% if use_cuda %},
  "runArgs": ["--gpus=all"],
  "hostRequirements": {
    "gpu": "optional"
  }{% endif %}
}
