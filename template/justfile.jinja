default: all

all: lint typecheck test

lint:
    uvx ruff check .
    uvx ruff format --check .

lint-fix:
    uvx ruff check --fix .
    uvx ruff format .

typecheck:
    uv run ty check src/

test:
    uv run pytest -rsx

test-fast:
    uv run pytest --no-cov -rsx

pre-commit:
    uv run pre-commit run --all-files

setup:
    uv sync --all-groups
    uv run pre-commit install
