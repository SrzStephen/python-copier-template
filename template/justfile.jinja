default: all

all: lint typecheck test

lint:
    uvx ruff check .
    uvx ruff format --check .
    npx prettier --check .

lint-fix:
    uvx ruff check --fix .
    uvx ruff format .
    npx prettier --write .

typecheck:
    uv run ty check src/

test:
    uv run pytest -rsx

test-fast:
    uv run pytest --no-cov -rsx

prek:
    uv run prek run --all-files

setup:
    uv sync --all-extras
    uv run prek install
