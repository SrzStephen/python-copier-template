name: Terraform

on:
  push:
    branches: [main]
  pull_request:

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "1.14"
      - uses: terraform-linters/setup-tflint@v4
      - name: Terraform fmt check
        run: terraform fmt -check -recursive
        working-directory: infra
      - name: tflint
        run: tflint --recursive
        working-directory: infra

  plan:
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "1.14"
      # Configure cloud provider credentials here, e.g.:
      # env:
      #   TF_API_TOKEN: ${{ "{{" }} secrets.TF_API_TOKEN {{ "}}" }}
      - name: Terraform Init
        run: terraform init
        working-directory: infra
      - name: Terraform Plan
        run: terraform plan
        working-directory: infra

  test:
    needs: lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Check for Terraform test files
        id: check-tests
        run: |
          if find infra -name "*.tftest.hcl" -print -quit 2>/dev/null | grep -q .; then
            echo "has_tests=true" >> $GITHUB_OUTPUT
          else
            echo "has_tests=false" >> $GITHUB_OUTPUT
          fi
      - uses: hashicorp/setup-terraform@v3
        if: steps.check-tests.outputs.has_tests == 'true'
        with:
          terraform_version: "1.14"
      - name: Terraform Init
        if: steps.check-tests.outputs.has_tests == 'true'
        run: terraform init
        working-directory: infra
      - name: Terraform Test
        if: steps.check-tests.outputs.has_tests == 'true'
        run: terraform test
        working-directory: infra

  apply:
    if: ${{ "{{" }} github.event_name == 'push' && github.ref == 'refs/heads/main' {{ "}}" }}
    needs: [lint, plan, test]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ "{{" }} github.ref {{ "}}" }}
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: "1.14"
      # Configure cloud provider credentials here, e.g.:
      # env:
      #   TF_API_TOKEN: ${{ "{{" }} secrets.TF_API_TOKEN {{ "}}" }}
      - name: Terraform Init
        run: terraform init
        working-directory: infra
      - name: Terraform Apply
        run: terraform apply -auto-approve
        working-directory: infra
